+# [isambard3] The Met Office extract, unchanged in mechanism: merge_sources.py
+# reads this suite's dependencies.yaml and clones each declared repo@ref into
+# $CYLC_WORKFLOW_SHARE_DIR/source. Editing dependencies.yaml (a fork, a branch, a
+# merge of both) is how a scientist changes what gets built here, exactly as at the
+# Met Office. Which of the three keys runs is chosen by USE_MIRRORS / USE_TOKENS in
+# rose-suite.conf, via ROSE_APP_COMMAND_KEY in flow.cylc.
+#
+# Two [isambard3] additions, both appended to the command rather than replacing it:
+#
+#   patch-sources.sh applies THIS repo's LFRic-source patch stack (patches/*-lfric_*)
+#   to the freshly cloned tree. Without it the build re-fetches its own science
+#   sources mid-compile and the vn3.2 forcing-only config trips an upstream
+#   slow-physics regression. See examples/science-suites/site/patch-sources.sh.
+#
+# `mirrors` points at this repo's vendored submodules by default (MIRROR_LOC in
+# rose-suite.conf) instead of the Met Office mirror host, which does not exist here.
+# That path needs no network at all; `tokens` (the default) clones from github over
+# https and works anonymously for these public repos.
 [command]
-default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR
-mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC
-tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens
+default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR ; \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
+mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC ; \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
+tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens ; \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
