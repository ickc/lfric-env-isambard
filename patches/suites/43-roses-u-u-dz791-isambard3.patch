+++ b/app/extract/rose-app.conf	2026-09-29 16:35:12.000000000 +0000
@@ -1,4 +1,29 @@
+# [isambard3] EXTENDED, not replaced. The extract is upstream's: merge_sources.py from
+# MetOffice/SimSys_Scripts reads this suite's dependencies.yaml and clones each declared
+# repo@ref into $SOURCE_ROOT.
+#
+# Two [isambard3] steps are APPENDED to each key rather than replacing the clone:
+#
+#   patch-sources.sh applies THIS repo's LFRic-source patch stack (patches/*-lfric_*) to
+#   the freshly cloned tree. Without it the apps build re-fetches its own science sources
+#   mid-compile, undoing the pin the suite just declared.
+#
+#   33-lfric_apps-dz791-profile-init-patch.sh adds THIS suite's science: Alex Corbett's
+#   t-and-rh-init-clean and qsaturation-use-epsilon branches, forward-ported to vn3.2. It
+#   is invoked BY PATH, from here, because it must not apply to any other suite -- see
+#   patches/optional/README.md and the note in dependencies.yaml.
+#
+# `&&`, not `;`: rose runs the command through a shell without `-e`, so with `;` the
+# task's exit status would be the LAST command's and a failed clone or patch would still
+# report SUCCESS to cylc, leaving build_lfric_atm to compile a missing or half-patched tree.
+
 [command]
-default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR
-mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC
-tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens
+default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/33-lfric_apps-dz791-profile-init-patch.sh"
+mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/33-lfric_apps-dz791-profile-init-patch.sh"
+tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/33-lfric_apps-dz791-profile-init-patch.sh"
