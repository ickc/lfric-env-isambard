+           first `cylc message`, before `rose task-env`, and before the task
+           [[[environment]]] block, so the module selection has to be exported HERE
+           rather than inherited. This is the one piece of glue Stage 1 cannot supply
+           from inside the module itself. #}
+        init-script = """
+                        {% if LFRIC_STACK %}export LFRIC_STACK="{{ LFRIC_STACK }}"{% endif %}
+                        {% if LFRIC_PREFIX %}export LFRIC_PREFIX="{{ LFRIC_PREFIX }}"{% endif %}
+                        {% if LFRIC_ENV_VERSION %}export LFRIC_ENV_VERSION="{{ LFRIC_ENV_VERSION }}"{% endif %}
+                        activate_env="{{ ACTIVATE_ENV }}"
+                        if [ -n "$activate_env" ] && [ -f "$activate_env" ]; then
+                          source "$activate_env"
+                        fi
+                        """
+{% endif %}
