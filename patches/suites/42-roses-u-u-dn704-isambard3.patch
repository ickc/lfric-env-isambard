--- app/lfric_atm/rose-app.conf	(revision 361458)
+++ app/lfric_atm/rose-app.conf	(working copy)
@@ -8,9 +8,20 @@
 ENSEMBLE_MEMBER=0
 EXEC_NAME=lfric_atm
 OMP_NUM_THREADS=1
-TOTAL_RANKS=1
-XIOS_SERVER_MODE=False
+# [isambard3] CHANGED: TOTAL_RANKS 1 -> 24 and XIOS_SERVER_MODE False -> True. This is the
+# multi-node case of the three science-suite examples, so it runs the model on 24 ranks
+# (C12 cubed-sphere, 4 per panel = 2x2) split across two nodes by the directives in
+# flow.cylc, with 1 DEDICATED XIOS server rank that owns the parallel-HDF5 one_file write
+# of the native UGRID Mesh2d. site/bin/launch-exe puts client and server in one
+# MPI_COMM_WORLD via `srun --multi-prog`. XIOS_SERVER_RANKS is upstream's.
+TOTAL_RANKS=24
+XIOS_SERVER_MODE=True
 XIOS_SERVER_RANKS=1
+# [isambard3] ADDED: cylc-run is on Lustre, which rejects the flock() HDF5 1.10+ takes on
+# files it creates -- XIOS's nc_create() of the NetCDF-4 output then aborts with
+# "Permission denied" after leaving a 0-byte file. site/activate-env.sh exports this too;
+# repeated here because the run task's [env] block is what the model sees.
+HDF5_USE_FILE_LOCKING=FALSE
 
 [file:$DESTINATION_DIRECTORY]
 mode=mkdir
