+# [isambard3] CHANGED: the two SimSys_Scripts sources off `git:localmirrors:`.
+# `localmirrors:` is a git alias a Met Office site sets up (`git config --global
+# url."<host>:/path/to/git_mirrors/".insteadOf "localmirrors:"`); there is no such mirror
+# host here. SimSys_Scripts is public, so https clones anonymously -- the same form the
+# tweak_iodef line above already uses upstream.
 [file:bin/get_git_sources.py]
-source=git:localmirrors:MetOffice/SimSys_Scripts.git::github_scripts/get_git_sources.py::main
+source=git:https://github.com/MetOffice/SimSys_Scripts.git::github_scripts/get_git_sources.py::main
 
 [file:bin/merge_sources.py]
-source=git:localmirrors:MetOffice/SimSys_Scripts.git::github_scripts/merge_sources.py::main
+source=git:https://github.com/MetOffice/SimSys_Scripts.git::github_scripts/merge_sources.py::main
 
 [template variables]
-EX_HOST="exab"
+# [isambard3] CHANGED: "exab" -> 'isambard3'. This is the switch that selects the
+# ISAMBARD3 family in flow.cylc; with any other value the workflow renders exactly as the
+# Met Office suite.
+EX_HOST='isambard3'
+# [isambard3] ADDED: the Slurm partitions the ISAMBARD3 family submits to.
+ISAMBARD3_RUN_PARTITION='grace'
+ISAMBARD3_SHARED_PARTITION='grace'
+# [isambard3] ADDED: sourced by every task before it runs (flow.cylc [[root]]
+# init-script) to `module load` the environment Stage 1 built. run-suite.sh injects the
+# real path via `cylc vip -S ACTIVATE_ENV=...`; empty here so the file is
+# path-independent and a Met Office run is unaffected.
+ACTIVATE_ENV=''
+# [isambard3] CHANGED: MIRROR_LOC/USE_MIRRORS/USE_TOKENS. Upstream extracts through the
+# Met Office git mirror host, which does not exist here, so the default path becomes
+# --tokens: https clones from github, which work anonymously for these six public
+# repositories. To extract offline from this repo's vendored submodules instead:
+#   run-suite.sh u-dn704 -S USE_MIRRORS=true -S "MIRROR_LOC='$PWD/vendor/mirrors'"
 MIRROR_LOC="localmirrors:"
-USE_MIRRORS=true
-USE_TOKENS=false
+USE_MIRRORS=false
+USE_TOKENS=true
