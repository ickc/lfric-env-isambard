--- a/app/extract/rose-app.conf	2026-08-12 01:51:43.000000000 +0000
+++ b/app/extract/rose-app.conf	2026-08-12 01:51:46.000000000 +0000
@@ -1,4 +1,30 @@
+# [isambard3] EXTENDED, not replaced. The extract is upstream's: merge_sources.py from
+# MetOffice/SimSys_Scripts reads this suite's dependencies.yaml and clones each declared
+# repo@ref into $SOURCE_ROOT.
+#
+# Two [isambard3] steps are APPENDED to each key rather than replacing the clone:
+#
+#   patch-sources.sh applies THIS repo's LFRic-source patch stack (patches/*-lfric_*) to
+#   the freshly cloned tree. Without it the apps build re-fetches its own science sources
+#   mid-compile, and the vn3.2 forcing-only config trips an upstream slow-physics
+#   regression.
+#
+#   32-lfric_apps-ice-giants-forcing-patch.sh adds THIS suite's science:
+#   dennissergeev/lfric_apps@ice_giants_tf forward-ported to vn3.2. It is invoked BY PATH,
+#   from here, because it must not apply to any other suite -- see patches/optional/README.md
+#   and the note in dependencies.yaml about why the fork cannot simply be declared there.
+#
+# `&&`, not `;`: rose runs the command through a shell without `-e`, so with `;` the task's
+# exit status would be the LAST command's and a failed clone or patch would still report
+# SUCCESS to cylc, leaving build_lfric_atm to compile a missing or half-patched tree.
+
 [command]
-default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR
-mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC
-tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens
+default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
+mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
+tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
