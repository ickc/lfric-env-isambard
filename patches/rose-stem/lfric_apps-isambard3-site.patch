diff --git a/rose-stem/site/isambard3/common/suite_config_isambard3.cylc b/rose-stem/site/isambard3/common/suite_config_isambard3.cylc
new file mode 100644
index 00000000..92fa9510
--- /dev/null
+++ b/rose-stem/site/isambard3/common/suite_config_isambard3.cylc
@@ -0,0 +1,114 @@
+{% do LOG.debug("Entered site/isambard3/common/suite_config_isambard3.cylc") %}
+
+{# Isambard 3 (Cray EX, Grace/aarch64, Slurm). The toolchain and the rose/cylc/
+   psyclone tools come from the lfric-env module (github.com/ickc/lfric-env-isambard).
+   Load it before launching; every task then loads the same module, found through
+   the two variables it sets: LFRIC_ENV_MODULEPATH and LFRIC_ENV_MODULE. #}
+{% set lfric_env_modulepath = environ.get("LFRIC_ENV_MODULEPATH", "") %}
+{% set lfric_env_module = environ.get("LFRIC_ENV_MODULE", "") %}
+{% if not lfric_env_module %}
+    {{ raise("site isambard3: load the lfric-env module before launching rose-stem "
+             "(module load lfric-env/<version>/cray); LFRIC_ENV_MODULE is unset.") }}
+{% endif %}
+
+{% set isambard3_base = 'umask 0022' %}
+
+{# A login shell resets Lmod, so each job loads the module itself. The site bin goes on
+   PATH for its mpiexec, which turns the `mpiexec -n N` that the mesh apps and the
+   test framework call into srun: the cray environment has no mpiexec. #}
+{% set isambard3_env = '. /opt/cray/pe/lmod/lmod/init/bash; module use ' ~ lfric_env_modulepath ~ '; module load ' ~ lfric_env_module ~ '; export PATH=$CYLC_WORKFLOW_RUN_DIR/site/isambard3/common/bin:$PATH' %}
+
+{% set isambard3_run = 'ulimit -s unlimited; export HDF5_USE_FILE_LOCKING=FALSE' %}
+
+    {# Tasks that run where the scheduler runs, e.g. export-source. #}
+    [[ISAMBARD3_ORIG]]
+        platform = localhost
+        init-script = {{ isambard3_env }}
+
+    {# No platform here: this family comes FIRST in every inherit list, and in Cylc the
+       first parent wins, so a platform set here would override ISAMBARD3_SLURM and put
+       the builds, tests and model runs on the login node. #}
+    [[ISAMBARD3_BASE]]
+        init-script = {{ isambard3_env }}
+        [[[environment]]]
+            SITE = 'isambard3'
+            BUILD_ROOT = $CYLC_WORKFLOW_RUN_DIR/share/lfric_build
+            HYPERTHREADS    = 1
+            CORES_PER_NODE  = 144
+            NUMA_REGIONS_PER_NODE = 4
+            ROSE_LAUNCHER = srun
+
+    [[ISAMBARD3_SLURM]]
+        platform = isambard3
+        [[[directives]]]
+            --partition = grace
+
+    [[ISAMBARD3_BUILD]]
+        inherit = ISAMBARD3_SLURM
+
+    [[ISAMBARD3_RUN]]
+        inherit = ISAMBARD3_SLURM
+        [[[environment]]]
+            ROSE_LAUNCHER_ULIMIT_OPTS = -s unlimited
+            BIG_DATA_DIR = '/projects/u35v/sw/lfricdata'
+            TARGET_PLATFORM = 'isambard3'
+            RUN_METHOD = srun
+            LAUNCH_SCRIPT = $CYLC_WORKFLOW_RUN_DIR/site/isambard3/common/bin
+
+    [[ISAMBARD3_GNU]]
+        [[[environment]]]
+            COMPILER = 'gnu'
+
+    [[ISAMBARD3_BUILD_GNU]]
+        inherit=ISAMBARD3_BASE,ISAMBARD3_BUILD,ISAMBARD3_GNU
+        {{ generate_script("pre-script", [isambard3_base]) }}
+
+    [[ISAMBARD3_RUN_GNU]]
+        inherit=ISAMBARD3_BASE,ISAMBARD3_RUN,ISAMBARD3_GNU
+        {{ generate_script("pre-script", [isambard3_base, isambard3_run]) }}
+
+    [[ISAMBARD3_MESH]]
+        inherit=ISAMBARD3_BASE,ISAMBARD3_SLURM
+
+    [[ISAMBARD3_MESH_GNU]]
+        inherit=ISAMBARD3_GNU,ISAMBARD3_MESH
+        {{ generate_script("pre-script", [isambard3_base]) }}
+
+    [[ISAMBARD3_TECH_BASE]]
+        inherit=ISAMBARD3_BASE
+
+    [[ISAMBARD3_TECH_TESTS]]
+        inherit=ISAMBARD3_TECH_BASE,ISAMBARD3_SLURM
+
+    [[ISAMBARD3_TECH_TESTS_GNU]]
+        inherit=ISAMBARD3_TECH_TESTS,ISAMBARD3_GNU
+        {{ generate_script("pre-script", [isambard3_base]) }}
+
+    {# The light script checks run on the login node, where the scheduler is. #}
+    [[ISAMBARD3_TECH]]
+        inherit=ISAMBARD3_TECH_BASE
+        platform = localhost
+        {{ generate_script("pre-script", [isambard3_base]) }}
+
+    [[ISAMBARD3_PLOT]]
+        inherit=ISAMBARD3_TECH_BASE
+        platform = localhost
+
+    [[ISAMBARD3_CHECK]]
+        inherit=ISAMBARD3_TECH
+
+    [[ISAMBARD3_SCRIPTS]]
+        inherit=ISAMBARD3_TECH
+
+    {# One shared filesystem: nothing to copy to another platform. #}
+    [[ISAMBARD3_EXPORT-SOURCE]]
+        inherit=ISAMBARD3_ORIG
+        [[[environment]]]
+            hostname = {{ ROSE_ORIG_HOST }}
+            PLATFORM_SYNC = false
+
+    [[ISAMBARD3_HOUSEKEEPING]]
+        inherit=ISAMBARD3_TECH_BASE
+        platform = localhost
+
+{% do LOG.debug("Finished in site/isambard3/common/suite_config_isambard3.cylc") %}
