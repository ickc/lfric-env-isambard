--- a/suites/u-dt000/app/git_extract_lfric/rose-app.conf
+++ b/suites/u-dt000/app/git_extract_lfric/rose-app.conf
@@ -1,70 +1,49 @@
-mode=command
-opt.jobs=1
-
+# [isambard3] REPLACED: the Met Office extract, in place of the bespoke one.
+#
+# Upstream this app was a ~60-line inline shell script that cloned
+# lfric_apps@vn2.2 and lfric_core@core2.2 over SSH, sourced lfric_apps'
+# `dependencies.sh` for the physics revisions, cloned those too, and then ran
+# `bin/patch_lfric_git_deps.py` over the result. It needed an SSH key or agent
+# forwarding, and the refs it built were spread across three places.
+#
+# What runs now is `merge_sources.py` from MetOffice/SimSys_Scripts (installed
+# into bin/ by rose-suite.conf) reading this suite's dependencies.yaml and cloning
+# each declared repo@ref into $CYLC_WORKFLOW_SHARE_DIR/source. That is the extract
+# every current Met Office LFRic suite uses, u-dr932 included: editing
+# dependencies.yaml — a different tag, your own fork, a fork merged onto a tag —
+# is how a scientist changes what gets built, exactly as at the Met Office. Which
+# of the three keys runs is chosen by USE_MIRRORS / USE_TOKENS in rose-suite.conf,
+# via ROSE_APP_COMMAND_KEY in flow.cylc.
+#
+# Two [isambard3] steps are appended to the clone rather than replacing it:
+#
+#   patch-sources.sh applies THIS repo's LFRic-source patch stack
+#   (patches/*-lfric_*) to the freshly cloned tree. Without it the build re-fetches
+#   its own science sources mid-compile, and the vn3.2 forcing-only config trips an
+#   upstream slow-physics regression. See examples/science-suites/site/patch-sources.sh.
+#
+#   32-lfric_apps-ice-giants-forcing-patch.sh adds THIS suite's science:
+#   dennissergeev/lfric_apps@ice_giants_tf forward-ported to vn3.2, i.e.
+#   `theta_forcing='ice_giants_obs_like'` and the three namelist items that come
+#   with it. It is invoked BY PATH, from here, because it must not apply to any
+#   other suite — see patches/optional/README.md and dependencies.yaml.
+#
+# The three are chained with `&&`, not `;`: rose runs the command through a shell
+# without `-e`, so with `;` the task's exit status is the LAST command's and a failed
+# clone or a failed patch would still report SUCCESS to cylc — leaving
+# build_lfric_atm to compile a missing or half-patched tree.
+#
+# `mirrors` points at this repo's vendored submodules by default (MIRROR_LOC in
+# rose-suite.conf) instead of the Met Office mirror host, which does not exist here.
+# That path needs no network at all; `tokens` (the default) clones from github over
+# https and works anonymously for these public repositories.
 [command]
-default=bash -eu -o pipefail -c '
-       =extract_dir="${CYLC_WORKFLOW_SHARE_DIR}/git_extract_lfric/extract"
-       =deps_dir="${extract_dir}/deps"
-       =rm -rf "${extract_dir}"
-       =mkdir -p "${extract_dir}" "${deps_dir}"
-       =if [ -n "${GIT_SSH_KEY:-}" ]; then
-       =  export GIT_SSH_COMMAND="ssh -i ${GIT_SSH_KEY} -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
-       =elif [ -n "${GIT_SSH_COMMAND:-}" ]; then
-       =  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND}"
-       =else
-       =  export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
-       =fi
-       =if [ -z "${SSH_AUTH_SOCK:-}" ]; then
-       =  echo "WARN: SSH_AUTH_SOCK is not set; ensure ssh-agent forwarding if using agent keys." >&2
-       =fi
-       =git_cmd=(git -c credential.helper=)
-       ="${git_cmd[@]}" clone --branch "${LFRIC_APPS_REF}" --depth 1 "${LFRIC_APPS_REMOTE}" "${extract_dir}/lfric_apps"
-       ="${git_cmd[@]}" clone --branch "${LFRIC_CORE_REF}" --depth 1 "${LFRIC_CORE_REMOTE}" "${extract_dir}/lfric_core"
-       =. "${extract_dir}/lfric_apps/dependencies.sh"
-       =if [ -n "${JULES_REV_OVERRIDE:-}" ]; then
-       =  jules_rev="${JULES_REV_OVERRIDE}"
-       =fi
-       =clone_dep() {
-       =  name="$1"
-       =  rev="$2"
-       =  remote="$3"
-       =  dest="${deps_dir}/${name}"
-       =  if [ -z "${remote}" ]; then
-       =    echo "ERROR: missing remote for ${name}" >&2
-       =    exit 1
-       =  fi
-       =  if [ -n "${rev}" ]; then
-       =    if [ "${name}" = "jules" ] && [ -n "${JULES_FALLBACK:-}" ]; then
-       =      if ! "${git_cmd[@]}" clone --branch "${rev}" --depth 1 "${remote}" "${dest}"; then
-       =        echo "WARN: ${name} rev ${rev} not found; falling back to ${JULES_FALLBACK}" >&2
-       =        rm -rf "${dest}"
-       =        "${git_cmd[@]}" clone --branch "${JULES_FALLBACK}" --depth 1 "${remote}" "${dest}"
-       =      fi
-       =    else
-       =      "${git_cmd[@]}" clone --branch "${rev}" --depth 1 "${remote}" "${dest}"
-       =    fi
-       =  else
-       =    "${git_cmd[@]}" clone --depth 1 "${remote}" "${dest}"
-       =  fi
-       =}
-       =if [ -n "${casim_sources:-}" ]; then echo "WARN: casim_sources ignored: ${casim_sources}" >&2; fi
-       =if [ -n "${ukca_sources:-}" ]; then echo "WARN: ukca_sources ignored: ${ukca_sources}" >&2; fi
-       =if [ -n "${jules_sources:-}" ]; then echo "WARN: jules_sources ignored: ${jules_sources}" >&2; fi
-       =if [ -n "${socrates_sources:-}" ]; then echo "WARN: socrates_sources ignored: ${socrates_sources}" >&2; fi
-       =clone_dep "casim" "${casim_rev:-}" "${CASIM_REMOTE}"
-       =clone_dep "ukca" "${ukca_rev:-}" "${UKCA_REMOTE}"
-       =clone_dep "jules" "${jules_rev:-}" "${JULES_REMOTE}"
-       =clone_dep "socrates" "${socrates_rev:-}" "${SOCRATES_REMOTE}"
-       ="${ROSE_SUITE_DIR}/bin/patch_lfric_git_deps.py" "${extract_dir}/lfric_apps"
-       ='
-
-[env]
-LFRIC_APPS_REF=vn2.2
-LFRIC_APPS_REMOTE=git@github.com:MetOffice/lfric_apps.git
-LFRIC_CORE_REF=core2.2
-LFRIC_CORE_REMOTE=git@github.com:MetOffice/lfric_core.git
-CASIM_REMOTE=git@github.com:MetOffice/casim.git
-UKCA_REMOTE=git@github.com:MetOffice/ukca.git
-JULES_REMOTE=git@github.com:MetOffice/JULES.git
-JULES_FALLBACK=stable
-SOCRATES_REMOTE=git@github.com:MetOffice/socrates.git
+default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
+mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
+tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT" && \
+       =LFRIC_SRC_ROOT="$SOURCE_ROOT" bash "$REPO_ROOT/patches/optional/32-lfric_apps-ice-giants-forcing-patch.sh"
