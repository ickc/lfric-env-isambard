--- a/suites/u-dn704/app/extract/rose-app.conf
+++ b/suites/u-dn704/app/extract/rose-app.conf
@@ -1,4 +1,22 @@
+# [isambard3] EXTENDED, not replaced. The extract itself is upstream's: merge_sources.py
+# from MetOffice/SimSys_Scripts reads this suite's dependencies.yaml and clones each
+# declared repo@ref into $SOURCE_ROOT. Editing dependencies.yaml — a different tag, your
+# own fork, a fork merged onto a tag — is how a scientist changes what gets built here,
+# exactly as at the Met Office. Which of the three keys runs is chosen by
+# USE_MIRRORS / USE_TOKENS in rose-suite.conf, via ROSE_APP_COMMAND_KEY in flow.cylc.
+#
+# One [isambard3] step is APPENDED to each key: patch-sources.sh applies THIS repo's
+# LFRic-source patch stack (patches/*-lfric_*) to the freshly cloned tree. Without it
+# the apps build re-fetches its own science sources mid-compile, undoing the pin the
+# suite just declared. See examples/science-suites/site/patch-sources.sh.
+#
+# `&&`, not `;`: rose runs the command through a shell without `-e`, so with `;` the
+# task's exit status would be the LAST command's and a failed clone would still report
+# SUCCESS to cylc — leaving build_lfric_atm to compile a missing tree.
 [command]
-default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR
-mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC
-tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens
+default=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
+mirrors=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --mirrors --mirror_loc=$MIRROR_LOC && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
+tokens=merge_sources.py -d $CYLC_WORKFLOW_RUN_DIR --tokens && \
+       =bash "$REPO_ROOT/examples/science-suites/site/patch-sources.sh" "$SOURCE_ROOT"
