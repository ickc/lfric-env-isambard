@@ -1,20 +1,44 @@
+# u-dn704 — LFRic Atm NWP GAL9 NoMG at C12, the Met Office EX example suite
+# (roses-u d/n/7/0/4/trunk), as ported to Isambard 3 by UniExeterRSE. Only the lines
+# marked [isambard3] below are this repo's; everything else is upstream's.
+#
+# The three [file:bin/*] sections install at `cylc install` time on the login node:
+# tweak_iodef from lfric_core, and the Met Office extract (get_git_sources.py +
+# merge_sources.py) from SimSys_Scripts.
 [file:bin/tweak_iodef]
 mode=auto
 source=git:https://github.com/MetOffice/lfric_core.git::bin/tweak_iodef::main
 
+# [isambard3] CHANGED: the two SimSys_Scripts sources ssh -> https
+# (git@github.com:MetOffice/... -> https://github.com/MetOffice/...). SimSys_Scripts is
+# public, so https clones anonymously; the ssh form needs a key registered with the Met
+# Office GitHub org, which a user of this environment need not have. Same change the
+# tweak_iodef line above already carries upstream.
 [file:bin/get_git_sources.py]
-source=git:git@github.com:MetOffice/SimSys_Scripts.git::github_scripts/get_git_sources.py::main
+source=git:https://github.com/MetOffice/SimSys_Scripts.git::github_scripts/get_git_sources.py::main
 
 [file:bin/merge_sources.py]
-source=git:git@github.com:MetOffice/SimSys_Scripts.git::github_scripts/merge_sources.py::main
+source=git:https://github.com/MetOffice/SimSys_Scripts.git::github_scripts/merge_sources.py::main
 
 [template variables]
 EX_HOST='isambard3'
-ISAMBARD3_SPACK_SETUP='../../env_lfric/working_dir/spack/share/spack/setup-env.sh'
+# [isambard3] CHANGED: ISAMBARD3_SPACK_SETUP pointed at the UniExeter port's own
+# in-tree spack ('../../env_lfric/working_dir/spack/share/spack/setup-env.sh'), and
+# ACTIVATE_ENV at its activate.sh. Both are emptied here: run-suite.sh injects
+# ACTIVATE_ENV via `cylc vip -S`, pointing at this repo's site/activate-env.sh, which
+# `module load`s the environment Stage 1 built. Emptying SPACK_SETUP is what makes the
+# ISAMBARD3 pre-script take the ACTIVATE_ENV branch instead of `spack env activate`.
+ISAMBARD3_SPACK_SETUP=''
 ISAMBARD3_SPACK_ENV='lfric-apps-isambard'
 ISAMBARD3_RUN_PARTITION='grace'
 ISAMBARD3_SHARED_PARTITION='grace'
 MIRROR_LOC=""
 USE_MIRRORS=false
-USE_TOKENS=false
-ACTIVATE_ENV='../../env_lfric/activate.sh'
+# [isambard3] CHANGED: USE_TOKENS false -> true. With both false the extract clones over
+# ssh, which needs a GitHub key registered with the Met Office org; `--tokens` switches
+# merge_sources.py to https URLs, which work anonymously for these public repositories.
+# There is no Met Office mirror host on Isambard 3, so USE_MIRRORS stays false — but to
+# extract offline from this repo's vendored submodules instead, pass both at launch:
+#   run-suite.sh u-dn704 -S USE_MIRRORS=true -S "MIRROR_LOC='$PWD/vendor/mirrors'"
+USE_TOKENS=true
+ACTIVATE_ENV=''
