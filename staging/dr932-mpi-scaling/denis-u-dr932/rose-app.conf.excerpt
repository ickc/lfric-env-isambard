meta=lfric-lfric_atm/vn3.1

[command]
default=$CORE_ROOT_DIR/bin/tweak_iodef; \
       =$LAUNCH_SCRIPT/launch-exe

[env]
CORES_PER_NODE=${CORES_PER_NODE}
ENSEMBLE_MEMBER=0
EXEC_NAME=lfric_atm
HYPERTHREADS=${HYPERTHREADS}
NUMA_REGIONS_PER_NODE=${NUMA_REGIONS_PER_NODE}
OMP_NUM_THREADS=1
RUN_METHOD=${RUN_METHOD}
TARGET_PLATFORM=${TARGET_PLATFORM}
TOTAL_RANKS=${TOTAL_RANKS_REQ}
XIOS_SERVER_MODE=False
XIOS_SERVER_RANKS=1

[file:$DESTINATION_DIRECTORY]
