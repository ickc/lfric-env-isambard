#!Jinja2
# The container's Cylc site config. activate.sh points CYLC_SITE_CONF_PATH here
# instead of at the module's, which this includes (site.cylc is a link to it,
# made by container/gen-env.sh), so the container gets the same platforms and
# run directory as the host environment, plus the one thing a container needs:
#
# A Cylc job on the `isambard3` platform is submitted to Slurm from inside the
# container (bin/sbatch, the host's sbatch), but Slurm starts it on the compute
# node in the HOST's environment, where the LFRic environment does not exist.
# The global init-script below runs in every job before the task does; if the
# job is not in the container yet, it re-runs the job file inside one, through
# the host helper. Inside, it is skipped and the job carries on as usual.
#
# The test is "is the image's env file here", not an environment variable:
# sbatch exports the submitting (container) environment to the job by default,
# so any variable set in the container would also be set in that first,
# host-side pass. The LFRIC_CONTAINER_* variables the helper needs are copied
# into the job explicitly ("copyable environment variables").
#
# The job file is re-run as "$0", Slurm's copy of it under /var/spool/slurmd
# (which the helper binds in for Slurm's own use). Not by its path in the run
# directory: Cylc sets CYLC_TASK_JOB, which that path needs, only later in the
# job script than this runs.
%include 'site.cylc'

[platforms]
    [[isambard3]]
        copyable environment variables = LFRIC_CONTAINER_IMAGE, LFRIC_CONTAINER_HELPER, LFRIC_CONTAINER_MPI, LFRIC_CONTAINER_BINDS
        global init-script = """
            # [container] re-run this job inside the LFRic container (lfric-container).
            if [[ ! -e /opt/lfric-env/container/env.sh ]]; then
                exec "${LFRIC_CONTAINER_HELPER:?LFRIC_CONTAINER_HELPER unset: start the workflow with lfric-container}" \
                    exec -- bash -l "$0" noreinvoke
            fi
        """
