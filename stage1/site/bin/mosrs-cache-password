#!/usr/bin/env bash
# mosrs-cache-password — cache your MOSRS password in gpg-agent, so svn and
# `rosie checkout` stop asking for it. Shipped by lfric-env (on PATH after
# `module load lfric-env/<version>/<variant>`).
#
# What it needs from you, once (it checks each and says exactly what to add; it
# never edits your dotfiles):
#   ~/.subversion/servers   [groups] metofficesharedrepos = code*.metoffice.gov.uk
#                           [metofficesharedrepos] username = <your MOSRS username>
#                           store-plaintext-passwords = no
#   ~/.subversion/config    [auth] password-stores = gpg-agent
#   ~/.gnupg/gpg-agent.conf allow-preset-passphrase
#                           (optionally: default-cache-ttl / max-cache-ttl, seconds)
#
# THE CACHE IS PER LOGIN NODE. gpg-agent's socket is under /run/user/$UID, which
# is node-local, and Isambard 3 assigns login nodes at random. Run this again
# after landing on a different login node (`hostname` tells you which one).
# Compute-node jobs do not see it at all: do svn/rosie work on the login node.
set -uo pipefail

REALM="<https://code.metoffice.gov.uk:443> Met Office Code"
TEST_URL="${MOSRS_TEST_URL:-https://code.metoffice.gov.uk/svn/roses-u}"

die()  { echo "mosrs-cache-password: $*" >&2; exit 1; }
need() { echo "mosrs-cache-password: $1" >&2; shift; printf '    %s\n' "$@" >&2; exit 1; }

# svn indexes a cached password by the MD5 of its realm string.
CACHE_ID="$(printf '%s' "$REALM" | md5sum | cut -d' ' -f1)"

preset=""
for p in /usr/lib/gpg-preset-passphrase /usr/lib64/gpg-preset-passphrase \
         /usr/libexec/gpg-preset-passphrase /usr/lib/gnupg/gpg-preset-passphrase; do
  [ -x "$p" ] && { preset="$p"; break; }
done
[ -n "$preset" ] || die "gpg-preset-passphrase not found (looked in /usr/lib{,64}, /usr/libexec)"
command -v svn >/dev/null || die "svn not on PATH"
command -v gpgconf >/dev/null || die "gpgconf not on PATH"

servers="$HOME/.subversion/servers"
config="$HOME/.subversion/config"
agentconf="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf"

grep -Eq '^[[:space:]]*username[[:space:]]*=' "$servers" 2>/dev/null \
  || need "no MOSRS username in $servers. Add:" \
       "[groups]" "metofficesharedrepos = code*.metoffice.gov.uk" \
       "[metofficesharedrepos]" "username = <your MOSRS username>" \
       "store-plaintext-passwords = no"
grep -Eq '^[[:space:]]*password-stores[[:space:]]*=.*gpg-agent' "$config" 2>/dev/null \
  || need "svn is not using gpg-agent. In $config, under [auth], add:" \
       "password-stores = gpg-agent"
grep -Eq '^[[:space:]]*allow-preset-passphrase' "$agentconf" 2>/dev/null \
  || need "gpg-agent does not accept preset passwords. Add to $agentconf:" \
       "allow-preset-passphrase" \
       "then run:  gpgconf --kill gpg-agent"

export GPG_TTY="${GPG_TTY:-$(tty 2>/dev/null || true)}"
gpgconf --launch gpg-agent || die "could not start gpg-agent"

read -r -s -p "MOSRS password: " password; echo
[ -n "$password" ] || die "no password entered"
printf '%s' "$password" | "$preset" --preset "$CACHE_ID" \
  || die "gpg-preset-passphrase failed (is allow-preset-passphrase active? gpgconf --kill gpg-agent)"
unset password

# svn only asks gpg-agent once it has an auth record for the realm saying so.
# The first time, let svn create it (it prompts once more, then remembers).
if ! grep -qs gpg-agent "$HOME/.subversion/auth/svn.simple/$CACHE_ID"; then
  echo "First use on this account: svn will ask for the password once more to record it."
  svn info "$TEST_URL" >/dev/null || die "svn could not authenticate to $TEST_URL"
fi

svn info --non-interactive "$TEST_URL" >/dev/null 2>&1 \
  || die "the cached password does not work for $TEST_URL (wrong password? run again)"
echo "MOSRS password cached in gpg-agent on $(hostname -s). Run this again on another login node."
