#!jinja2

{# ============================================================================
   u-dr932 as run on Isambard 3 against the lfric-env module (this repo).

   This IS Denis Sergeev's suite (dennissergeev/lfric_egp_bench@ffe611e,
   src/suites/u-dr932), not a rewrite of it: the hostname->MACHINE detection, the
   task graph, the Met Office `launch-exe`, the app configs and every other
   platform's branch are his, untouched. Only the `isambard3-gnu` branch is
   changed, and only where the platform requires it. Every such change is marked
   `[isambard3]` in a comment saying what it replaced and why. See README.md here
   for the full list; see examples/science-suites/README.md for the contract.

   The five variables below are injected by run-suite.sh (`cylc vip -S ...`) so
   the suite stays path-independent; each defaults to empty, which is what makes
   the other MACHINE branches render unchanged.
   ============================================================================ #}
{% if ACTIVATE_ENV       is not defined %}{% set ACTIVATE_ENV       = '' %}{% endif %}
{% if REPO_ROOT          is not defined %}{% set REPO_ROOT          = '' %}{% endif %}
{% if LFRIC_STACK        is not defined %}{% set LFRIC_STACK        = '' %}{% endif %}
{% if LFRIC_PREFIX       is not defined %}{% set LFRIC_PREFIX       = '' %}{% endif %}
{% if LFRIC_ENV_VERSION  is not defined %}{% set LFRIC_ENV_VERSION  = '' %}{% endif %}

{% from "socket" import getfqdn %}
{% from "cylc.flow" import LOG %}

{% set ISODATETIME = "isodatetime --calendar=" ~ "gregorian" %}

# Machine specific settings
{% if MO_EX_HOST == 'ex' %}
# Monsoon
    {% set SPACK = '/projects/metoff/spackadmin.mon/releases/2025.12.18/ngms' %}
    {% set SHARED_QUEUE = 'collabshared' %}
    {% set RUN_QUEUE = 'collab' %}
{% else %}
# Met Office ex1a
    {% set SPACK = '/common/internal/spack/ngms' %}
    {% set SHARED_QUEUE = 'shared' %}
    {% set RUN_QUEUE = 'normal' %}
{% endif %}

[scheduler]
    UTC mode = True
    install = dependencies.yaml

[scheduling]
    cycling mode        = "gregorian"
    initial cycle point = {{EXPT_START}}
    stop after cycle point = +{{EXPT_RUNLEN}}-{{EXPT_RESUB}}
    runahead limit      = P1D

    [[graph]]
        # Initial cycle point
        R1 = """
            {{ '' }}

            {# Build executable, if required #}
            {% if BUILD_LFRIC %}
                extract => build_mesh => generate_mesh
                extract => build_lfric_atm => lfric_atm
            {% else %} {# Not building execs #}
                build_mesh => generate_mesh
            {% endif %} {# Test on build #}
            generate_mesh => lfric_atm
        """

        # Following cycle points
        {{EXPT_RESUB}} = lfric_atm[-{{EXPT_RESUB}}] => lfric_atm

{# ### Set MACHINE automatically depending on the host name ### #}
{% set hostname = getfqdn() %}
{% if "epic.astro" in hostname %}
    {% set MACHINE = "uoe-epic-gnu" %}
{% elif "collab.sc" in hostname %}
    {% set MACHINE = "ex1a-monsoon" %}
{% elif "d3-login" in hostname %}
    {% set MACHINE = "dial3-gnu" %}
{% elif "i3.isambard" in hostname %}
    {% set MACHINE = "isambard3-gnu" %}
{% else %}
    {% set MACHINE = "Could it be Met Office EX1?" %}
{% endif %}
{% do LOG.info("MACHINE: " + MACHINE) %}

{# ####### Set CORES_PER_NODE and derive LFRIC_ATM_NODES ###### #}
{% if MACHINE == "ex1a-monsoon" %}
    {% set CORES_PER_NODE = 128 %}
{% elif MACHINE == "dial3-gnu" %}
    {% set CORES_PER_NODE = 128 %}
{% elif MACHINE == "isambard3-gnu" %}
    {% set CORES_PER_NODE = 144 %}
{% elif MACHINE == "uoe-epic-gnu" %}
    {% set CORES_PER_NODE = 1 %}
{% else %}
    {% set CORES_PER_NODE = 128 %}
{% endif %}
{% set LFRIC_ATM_NODES = (TOTAL_RANKS_REQ / CORES_PER_NODE) | round(0, 'ceil') | int %}
{# [isambard3] ADDED: ranks per node, spread evenly over the nodes asked for.
   Slurm needs this stated EXPLICITLY -- given only --ntasks it is free to take a
   handful of ranks from each of a dozen partially-free nodes, which is what made
   this suite 3-4x slower than Monsoon (staging/dr932-mpi-scaling/README.md). #}
{% set LFRIC_ATM_PPN = (TOTAL_RANKS_REQ / LFRIC_ATM_NODES) | round(0, 'ceil') | int %}
{% do LOG.info("CORES_PER_NODE: " ~ CORES_PER_NODE ~ ", LFRIC_ATM_NODES: " ~ LFRIC_ATM_NODES ~ ", LFRIC_ATM_PPN: " ~ LFRIC_ATM_PPN) %}


{# ============================================================ #}
{# Global runtime settings                                      #}
{# ============================================================ #}
[runtime]
    [[root]]
{% if MACHINE == "isambard3-gnu" %}
        {# [isambard3] ADDED: re-activate the built environment for EVERY task.
           Cylc runs each job under a login shell (`bash -l`), which resets Lmod to
           the system defaults and purges the lfric-env module the scheduler had
           loaded -- so the view's bin/ is dropped and the job dies with
           `cylc: command not found` (exit 127) BEFORE any pre-script runs.
           init-script runs before cylc's first `cylc message`, before `rose
           task-env`, and before the task [[[environment]]] block, so the module
           selection has to be exported here rather than inherited. This is the one
           piece of glue Stage 1 cannot supply from inside the module itself. #}
        init-script = """
            {% if LFRIC_STACK %}export LFRIC_STACK="{{ LFRIC_STACK }}"{% endif %}
            {% if LFRIC_PREFIX %}export LFRIC_PREFIX="{{ LFRIC_PREFIX }}"{% endif %}
            {% if LFRIC_ENV_VERSION %}export LFRIC_ENV_VERSION="{{ LFRIC_ENV_VERSION }}"{% endif %}
            activate_env="{{ ACTIVATE_ENV }}"
            if [ -n "$activate_env" ] && [ -f "$activate_env" ]; then
              source "$activate_env"
            fi
            """
{% endif %}
        env-script = eval $(rose task-env)
        script = "rose task-run --verbose"
        [[[events]]]
            {# mail events = submission failed, submission timeout, submission retry, retry, failed, timeout #}
            submission timeout = PT3H
            execution timeout  = PT3H
        [[[environment]]]
            ROSE_ORIG_HOST={{ ROSE_ORIG_HOST }}
            SOURCE_ROOT = $CYLC_WORKFLOW_SHARE_DIR/source
            OUTPUT_ROOT = $CYLC_WORKFLOW_SHARE_DIR/output
            DESTINATION_DIRECTORY = $OUTPUT_ROOT
            SUITE_NAME = $CYLC_WORKFLOW_NAME
            MESH_DIR = $OUTPUT_ROOT/meshes
            MESH_RES = {{ LFRIC_RES[:-3] }}
            PHYSICS_ROOT=$SOURCE_ROOT
            APPS_ROOT_DIR = $SOURCE_ROOT/lfric_apps
            CORE_ROOT_DIR = $SOURCE_ROOT/lfric_core
            LAUNCH_SCRIPT = $APPS_ROOT_DIR/rose-stem/site/meto/common/bin
            VN = {{ VN }}
{% if MACHINE == "isambard3-gnu" %}
            {# [isambard3] ADDED: where this repo lives, so the extract task can
               apply its LFRic-source patch stack to the freshly cloned tree. #}
            REPO_ROOT = {{ REPO_ROOT }}
{% endif %}
            TARGET_LONLAT = {{TARGET_LONLAT[0]}},{{TARGET_LONLAT[1]}}
            STRETCH_FACTOR = {{STRETCH_FACTOR}}
            EQ_LAT = $(bc -l <<< "x=(1-$STRETCH_FACTOR^2)/(1+$STRETCH_FACTOR^2); a(x/sqrt(1-x^2))*45/a(1)")

    [[EX1A]]
        {% if COMPILER == 'cce' %}
        pre-script = """
            module use {{SPACK}}
            module switch PrgEnv-cray PrgEnv-cray/8.4.0
            module load cpe/23.05
            module switch cce cce/15.0.0
            module load lfric-cray/15.0.0/3.1 || true
            ulimit -s unlimited -c unlimited
            ulimit -a
            module list 2>&1
            """
        {% else %}
        pre-script = """
            module use {{SPACK}}
            module switch cpe/22.11 cpe/23.05
            module load PrgEnv-gnu
            module load gcc/12.2.0
            module load lfric-gnu/12.2.0/3.1 || true
            ulimit -s unlimited -c unlimited
            ulimit -a
            module list 2>&1
            """
        {% endif %}
        platform = {{ MO_EX_HOST }}
        [[[environment]]]
            BIG_DATA_DIR = '/data/users/lfricadmin/data'
            BUILD_ROOT = ${TMPDIR}
            CORES_PER_NODE = {{ CORES_PER_NODE }}
            HYPERTHREADS = 1
            NUMA_REGIONS_PER_NODE = 2
            RUN_METHOD = mpiexec
            TOTAL_RANKS_REQ = {{TOTAL_RANKS_REQ}}

{% if MACHINE == "uoe-epic-gnu" %}
    [[EPICGNU]]
        pre-script = """
            module purge
            umask 0022
            source /home/um/UoEGCC1120SWstackBuild/RoseStemSource.sh
            ulimit -s unlimited
            module list 2>&1
            """
        platform = localhost
        [[[environment]]]
            BIG_DATA_DIR = '/data/lfric/data'
            BUILD_ROOT=$CYLC_WORKFLOW_SHARE_DIR/lfric_build
            HYPERTHREADS    = 1
            CORES_PER_NODE  = {{ CORES_PER_NODE }}
            NUMA_REGIONS_PER_NODE = 0
            RUN_METHOD = mpiexec
            TOTAL_RANKS_REQ = {{TOTAL_RANKS_REQ}}
{% endif %}


{% if MACHINE == "dial3-gnu" %}
    [[DIAL3GNU]]
        pre-script = """
            module purge
            umask 0022
            source /scratch/dp015/dc-uoeum/UoEGCC1120SWstackBuild/RoseStemSource.sh
            ulimit -s unlimited
            module list 2>&1
            """
        platform = uoe-dial3
        [[[environment]]]
            BIG_DATA_DIR = '/scratch/dp015/dc-uoeum/lfric/data'
            BUILD_ROOT=$CYLC_WORKFLOW_SHARE_DIR/lfric_build
            HYPERTHREADS    = 1
            CORES_PER_NODE  = {{ CORES_PER_NODE }}
            NUMA_REGIONS_PER_NODE = 0
            RUN_METHOD = mpiexec
            TOTAL_RANKS_REQ = {{TOTAL_RANKS_REQ}}
        [[[directives]]]
            --account=dp015
            --partition=devel
{% endif %}


{% if MACHINE == "isambard3-gnu" %}
    [[ISAMBARD3GNU]]
        {# [isambard3] CHANGED: `source .../UoEGCC1120SWstackBuild/RoseStemSource.sh`
           -> source the ACTIVATE_ENV that `module load`s lfric-env. That one module
           is the whole toolchain contract (compiler wrappers, Cray PE, the view's
           FFLAGS/LDFLAGS); nothing else here re-derives any of it. Kept: umask and
           the stack ulimit. Dropped `module purge` -- the module manages the Cray PE
           modules itself and purging after init-script already loaded it would undo
           the activation. #}
        pre-script = """
            umask 0022
            activate_env="{{ ACTIVATE_ENV }}"
            if [ -n "$activate_env" ] && [ -f "$activate_env" ]; then
              source "$activate_env"
            fi
            ulimit -s unlimited -c unlimited
            ulimit -a
            module list 2>&1
            """
        {# [isambard3] CHANGED: platform uoe-isambard3 -> isambard3, the Slurm
           platform scripts/setup-cylc.sh writes into ~/.cylc/flow/global.cylc. #}
        platform = isambard3
        [[[environment]]]
            BIG_DATA_DIR = '/projects/u35v/sw/lfricdata'
            BUILD_ROOT=$CYLC_WORKFLOW_SHARE_DIR/lfric_build
            HYPERTHREADS    = 1
            CORES_PER_NODE  = {{ CORES_PER_NODE }}
            {# [isambard3] CHANGED: 0 -> 2. A Grace node is 2 sockets x 72 cores. #}
            NUMA_REGIONS_PER_NODE = 2
            {# [isambard3] CHANGED: mpiexec -> srun. srun is what binds cray-mpich to
               Slingshot's cxi provider through the Cray PMI, and it pins one rank per
               core without being asked; the cray environment ships no mpiexec at all.
               The stock Met Office launch-exe already handles RUN_METHOD=srun for a
               run with XIOS attached, so LAUNCH_SCRIPT stays upstream's. #}
            RUN_METHOD = srun
            TOTAL_RANKS_REQ = {{TOTAL_RANKS_REQ}}
        [[[directives]]]
{#            --account=u35v #}
{#            --partition=devel #}
{% endif %}



    [[BUILD]]
{% if MACHINE == "uoe-epic-gnu" %}
        inherit = EPICGNU
        script = "rose task-run --app-key=build"
        [[[environment]]]
            {# COMPILER = {{ COMPILER }} #}
            COMPILER = 'gnu'
            PROFILE = 'production'
            TARGET = build
            PSYCLONE_TRANSFORMATION = uoe-epic
            UM_FCM_TARGET_PLATFORM = uoe-epic
            LFRIC_TARGET_PLATFORM = uoe-epic
            MAKE_THREADS = 6
            RDEF_PRECISION = 32
            R_TRAN_PRECISION = 32
            R_BL_PRECISION = 32
            R_SOLVER_PRECISION = 32
            R_PHYS_PRECISION = 64
            PRE_PROCESS_MACROS = ""
{% else %}

{% if MACHINE == "dial3-gnu" %}
        inherit = DIAL3GNU
        script = "rose task-run --app-key=build"
        [[[environment]]]
            {# COMPILER = {{ COMPILER }} #}
            COMPILER = 'gnu'
            PROFILE = 'production'
            TARGET = build
            PSYCLONE_TRANSFORMATION = uoe-dial3
            UM_FCM_TARGET_PLATFORM = uoe-dial3
            LFRIC_TARGET_PLATFORM = uoe-dial3
            MAKE_THREADS = 6
            RDEF_PRECISION = 32
            R_TRAN_PRECISION = 32
            R_BL_PRECISION = 32
            R_SOLVER_PRECISION = 32
            R_PHYS_PRECISION = 64
            PRE_PROCESS_MACROS = ""
        [[[directives]]]
            --ntasks=6
            --mem-per-cpu=1G
            --export=NONE
{% else %}

{% if MACHINE == "isambard3-gnu" %}
        inherit = ISAMBARD3GNU
        script = "rose task-run --app-key=build"
        [[[environment]]]
            {# COMPILER = {{ COMPILER }} #}
            COMPILER = 'gnu'
            PROFILE = 'production'
            TARGET = build
            PSYCLONE_TRANSFORMATION = uoe-dial3
{#            PSYCLONE_TRANSFORMATION = uoe-isambard3 #}
            UM_FCM_TARGET_PLATFORM = uoe-isambard3
            LFRIC_TARGET_PLATFORM = uoe-isambard3
            {# [isambard3] ADDED: take the compiler from the loaded module rather
               than hardcoding one. FC/LDMPI/FPP resolve to Cray ftn/CC on the cray
               variant and to the view's mpif90/mpic++ on spack, so switching
               LFRIC_STACK needs no edit here. This is THE Stage-1 contract: the
               module exports the toolchain, the suite consumes it. #}
            FC = $FC
            LDMPI = $LDMPI
            FPP = $FPP
            MAKE_THREADS = 6
            RDEF_PRECISION = 32
            R_TRAN_PRECISION = 32
            R_BL_PRECISION = 32
            R_SOLVER_PRECISION = 32
            R_PHYS_PRECISION = 64
            PRE_PROCESS_MACROS = ""
        [[[directives]]]
            --nodes=1
            --ntasks=1
            --cpus-per-task=6
            --mem=40G
            {# [isambard3] CHANGED: was `--ntasks=6 --mem-per-cpu=10G --export=NON`.
               Three fixes. (1) `make -j6` is 6 THREADS in one task, so it needs
               --cpus-per-task=6, not --ntasks=6: as 6 tasks Slurm may scatter them
               over 6 nodes and confine each to one core. (2) `--export=NON` is a
               typo for NONE, and NONE is wrong here anyway -- see the lfric_atm
               directives below. (3) 40G total rather than 10G/cpu; a psyclone+gfortran
               build of lfric_atm peaks well under that. #}
{% else %}
        inherit = EX1A
        script = "rose task-run --app-key=build"
        [[[environment]]]
            COMPILER = {{COMPILER}}
            PROFILE = 'production'
            TARGET = build
            PSYCLONE_TRANSFORMATION = meto-ex1a
            UM_FCM_TARGET_PLATFORM = meto-ex1a
            LFRIC_TARGET_PLATFORM = meto-ex1a
            MAKE_THREADS = 6
            RDEF_PRECISION = 32
            R_TRAN_PRECISION = 32
            R_BL_PRECISION = 32
            R_SOLVER_PRECISION = 32
            R_PHYS_PRECISION = 64
            PRE_PROCESS_MACROS = ""
        [[[directives]]]
            -l select=1:ncpus=24:mem=40GB:tmpsize=12GB
            -l walltime=01:00:00
            -q={{SHARED_QUEUE}}
{% endif %}
{% endif %}
{% endif %}

{# ######################## TASKS ############################# #}

{# ============================================================ #}
{# Fetch source                                                 #}
{# ============================================================ #}
    [[extract]]
{% if MACHINE == "uoe-epic-gnu" %}
        inherit = EPICGNU
        script = "rose task-run --app-key=extract"
        [[[environment]]]
            MIRROR_LOC = {{ MIRROR_LOC }}
            {% if USE_MIRRORS %}
                ROSE_APP_COMMAND_KEY = mirrors
            {% elif USE_TOKENS %}
                ROSE_APP_COMMAND_KEY = tokens
            {% endif %}
{% else %}

{% if MACHINE == "dial3-gnu" %}
        inherit = DIAL3GNU
        script = "rose task-run --app-key=extract"
        [[[environment]]]
            MIRROR_LOC = {{ MIRROR_LOC }}
            {% if USE_MIRRORS %}
                ROSE_APP_COMMAND_KEY = mirrors
            {% elif USE_TOKENS %}
                ROSE_APP_COMMAND_KEY = tokens
            {% endif %}
        [[[directives]]]
            --ntasks=1
            --mem-per-cpu=1G
            --export=NONE
{% else %}

{% if MACHINE == "isambard3-gnu" %}
        inherit = ISAMBARD3GNU
        script = "rose task-run --app-key=extract"
        [[[environment]]]
            {# [isambard3] CHANGED: the Met Office mirror host is not reachable from
               here, so `--mirrors` points at this repo's vendored submodules in the
               same MetOffice/<repo>.git layout (vendor/mirrors/). That path is fully
               offline. The default is USE_TOKENS=true -> https clones from github,
               which works anonymously for these public repositories. #}
            MIRROR_LOC = {{ REPO_ROOT }}/vendor/mirrors
            {% if USE_MIRRORS %}
                ROSE_APP_COMMAND_KEY = mirrors
            {% elif USE_TOKENS %}
                ROSE_APP_COMMAND_KEY = tokens
            {% endif %}
        [[[directives]]]
            --nodes=1
            --ntasks=1
            --time=00:29:00
            --mem=8G
            {# [isambard3] CHANGED: --mem-per-cpu=1G -> --mem=8G (six git clones and
               their checkouts), and --export=NONE dropped -- see lfric_atm below. #}

{% else %}
        inherit = EX1A
        script = "rose task-run --app-key=extract"
        [[[environment]]]
            MIRROR_LOC = {{ MIRROR_LOC }}
            {% if USE_MIRRORS %}
                ROSE_APP_COMMAND_KEY = mirrors
            {% elif USE_TOKENS %}
                ROSE_APP_COMMAND_KEY = tokens
            {% endif %}
        [[[directives]]]
            -l select=1:ncpus=1:mem=6GB:tmpsize=6GB
            -l walltime=00:10:00
            -q={{SHARED_QUEUE}}
{% endif %}
{% endif %}
{% endif %}


{# ============================================================ #}
{# Compile mesh generator                                       #}
{# ============================================================ #}
    [[build_mesh]]
        inherit = BUILD
        execution time limit = PT10M
        [[[environment]]]
            SOURCE_DIRECTORY = $CORE_ROOT_DIR/mesh_tools
            WORKING_DIR = $BUILD_ROOT/mesh
            BIN_DIR = $OUTPUT_ROOT/bin/mesh


{# ============================================================ #}
{# Compile LFRic                                                #}
{# ============================================================ #}
    [[build_lfric_atm]]
        inherit = BUILD
        execution time limit = PT1H
        [[[environment]]]
            SOURCE_DIRECTORY = $APPS_ROOT_DIR/applications/lfric_atm
            WORKING_DIR = $BUILD_ROOT/lfric_atm
            BIN_DIR = $OUTPUT_ROOT/bin/lfric_atm


{# ============================================================ #}
{# Run mesh generator                                           #}
{# ============================================================ #}
    [[generate_mesh]]
{% if MACHINE == "uoe-epic-gnu" %}
        inherit = EPICGNU
        script = "rose task-run --app-key=mesh"
        execution time limit = PT10M
        [[[environment]]]
            BIN_DIR = $OUTPUT_ROOT/bin/mesh
            ROSE_APP_OPT_CONF_KEYS = {{LFRIC_RES}}
            OUTPUT_FILE_PREFIX = $MESH_DIR/mesh_{{LFRIC_RES}}
{% else %}

{% if MACHINE == "dial3-gnu" %}
        inherit = DIAL3GNU
        script = "rose task-run --app-key=mesh"
        execution time limit = PT10M
        [[[environment]]]
            BIN_DIR = $OUTPUT_ROOT/bin/mesh
            ROSE_APP_OPT_CONF_KEYS = {{LFRIC_RES}}
            OUTPUT_FILE_PREFIX = $MESH_DIR/mesh_{{LFRIC_RES}}
        [[[directives]]]
            --ntasks=6
            --mem-per-cpu=1G
            --export=NONE
{% else %}

{% if MACHINE == "isambard3-gnu" %}
        inherit = ISAMBARD3GNU
        script = """
            echo "STRETCH_FACTOR="${STRETCH_FACTOR}
            echo "EQ_LAT="${EQ_LAT}
            echo "TARGET_LONLAT="${TARGET_LONLAT}
            rose task-run --app-key=mesh
            """
        execution time limit = PT10M
        [[[environment]]]
            BIN_DIR = $OUTPUT_ROOT/bin/mesh
            ROSE_APP_OPT_CONF_KEYS = {{LFRIC_RES}}
            OUTPUT_FILE_PREFIX = $MESH_DIR/mesh_{{LFRIC_RES}}
            {# [isambard3] ADDED: the mesh generator is a serial tool run under srun
               (app/mesh/rose-app.conf); keep it to one thread. #}
            OMP_NUM_THREADS = 1
        [[[directives]]]
            --nodes=1
            --ntasks=1
            --time=00:29:00
            --mem=6G
            {# [isambard3] CHANGED: --ntasks=6 -> 1. The command is a single-rank
               cubedsphere_mesh_generator; asking for 6 tasks let Slurm place them on
               6 different nodes. --export=NONE dropped -- see lfric_atm below. #}

{% else %}
        inherit = EX1A
        script = "rose task-run --app-key=mesh"
        execution time limit = PT10M
        [[[environment]]]
            BIN_DIR = $OUTPUT_ROOT/bin/mesh
            ROSE_APP_OPT_CONF_KEYS = {{LFRIC_RES}}
            OUTPUT_FILE_PREFIX = $MESH_DIR/mesh_{{LFRIC_RES}}
        [[[directives]]]
            -l select=1:ncpus=1:mem=6GB:tmpsize=6GB
            -l walltime=00:10:00
            -q={{SHARED_QUEUE}}
{% endif %}
{% endif %}
{% endif %}


{# ============================================================ #}
{# Run LFRic                                                    #}
{# ============================================================ #}
    [[lfric_atm]]
        execution retry delays = PT1M, PT10M  # retry twice: after 1 min, then after 10 min
        submission retry delays = 2*PT30M     # retry failed submissions
{% if MACHINE == "uoe-epic-gnu" %}
        inherit = EPICGNU
{% else %}
{% if MACHINE == "dial3-gnu" %}
        inherit = DIAL3GNU
{% else %}
{% if MACHINE == "isambard3-gnu" %}
        inherit = ISAMBARD3GNU
{% else %}
        inherit = EX1A
{% endif %}
{% endif %}
{% endif %}
        script = """
            echo "====Forecast times===="
            echo "Forecast start date="${STARTDATE}
            echo "Forecast starttime="${STARTTIME}
            echo "Forecast STOPTIME="${STOPTIME}
            echo "Forecast TIME_ORIGIN="${TIME_ORIGIN}
            echo "Forecast RESTART_READ="${RESTART_READ}
            echo "Forecast RESTART_START="${RESTART_START}
            echo "Forecast RESTART_STOP="${RESTART_STOP}
            echo "====Computational resources===="
            echo "TOTAL_RANKS_REQ="${TOTAL_RANKS_REQ}
            echo "CORES_PER_NODE="${CORES_PER_NODE}
            echo "LFRIC_ATM_NODES="${LFRIC_ATM_NODES}
            mkdir -p $ROSE_DATA/History_Data
            rose task-run --app-key=lfric_atm
            """
        {% if HOUSEKEEPING %}
        post-script = """
            # Remove XIOS logs on succesful completion
            rm xios_client_*.{err,out}
            """
        {% endif %}

        execution time limit = {{LFRIC_CPU}}
        [[[environment]]]
            DT = {{EXPT_DT}}
            {% if MACHINE == "uoe-epic-gnu" %}
                TARGET_PLATFORM = uoe-epic
            {% else %}
            {% if MACHINE == "dial3-gnu" %}
                TARGET_PLATFORM = uoe-dial3
            {% else %}
            {% if MACHINE == "isambard3-gnu" %}
                TARGET_PLATFORM = uoe-isambard3
            {% else %}
                TARGET_PLATFORM = meto-ex1a
            {% endif %}
            {% endif %}
            {% endif %}
            METADATA = $APPS_ROOT_DIR/applications/lfric_atm/metadata
            BIN_DIR = $OUTPUT_ROOT/bin/lfric_atm
{% if MACHINE == "isambard3-gnu" %}
            {# [isambard3] ADDED: cray-mpich prints its OFI provider and each rank's
               NIC into job.out. `provider: cxi` is the one-line proof the run is on
               Slingshot rather than falling back to TCP. #}
            MPICH_ENV_DISPLAY = 1
            MPICH_OFI_NIC_VERBOSE = 2
{% endif %}
            STARTDATE = $({{ISODATETIME}} -f "%F %T" {{EXPT_START}})
            STARTTIME = $({{ISODATETIME}} --as-total=s {{EXPT_START}} ref)
            STOPTIME = $({{ISODATETIME}} --as-total=s --offset2={{EXPT_RESUB}} {{EXPT_START}} ref)
            TIME_ORIGIN = $({{ISODATETIME}} -f "%F %T" {{EXPT_START}})
            RESTART_READ = $(if [ $CYLC_TASK_CYCLE_POINT = $CYLC_WORKFLOW_INITIAL_CYCLE_POINT ]; then echo ".false."; else echo ".true."; fi)
            RESTART_WRITE = .true.
            RESTART_START = $(bc <<< $STARTTIME/$DT+1)
            RESTART_STOP = $(bc <<< $STOPTIME/$DT)
            LFRIC_ATM_NODES = {{ LFRIC_ATM_NODES }}
            ROSE_APP_OPT_CONF_KEYS = {{CASE_SETUP}} {{PHYSICS_CONF}} {{LFRIC_LEVS}}
            TASK_OUTPUT_DIR = $OUTPUT_ROOT/lfric_atm
{% if MACHINE == "uoe-epic-gnu" %}
        [[[directives]]]
{% else %}
{% if MACHINE == "dial3-gnu" %}
        [[[directives]]]
            --mem-per-cpu=8G
            --ntasks={{TOTAL_RANKS_REQ}}
            --cpus-per-task=1
            --export=NONE
            --nodes={{ LFRIC_ATM_NODES }}
            --ntasks-per-node={{ CORES_PER_NODE }}
{% else %}
{% if MACHINE == "isambard3-gnu" %}
        [[[directives]]]
            {# [isambard3] CHANGED, and this is the change that mattered: state the
               placement, never leave it to Slurm. Was:
                   --mem-per-cpu=8G --ntasks=N --cpus-per-task=1 --export=NONE
               With no node count asked for, and 8G/core capping a 230400 MB Grace
               node at 28 of these ranks, Slurm satisfied a 108-rank job out of
               whatever had room -- 9 to 32 nodes, 1-13 ranks each, and 5h-to-9h on
               identical work. Measured in full in staging/dr932-mpi-scaling/.
               - --nodes + --ntasks-per-node pack the ranks onto as few nodes as
                 possible (108 fit on one).
               - --mem=0 takes the node's whole memory, so a memory request can never
                 cap ranks-per-node and fan the job out again. Safe: Slurm accounting
                 puts this configuration's peak at 8-35 GB for the WHOLE job against
                 225 GB on a node, i.e. the 8G/core was over-provisioned ~25-100x.
                 Re-measure before assuming that holds at C384 or above.
               - --exclusive because SelectType is select/cons_tres (CR_CORE_MEMORY):
                 Slurm hands out cores, not machines, and 1493 jobs from 20 other
                 users touched the 32 nodes of one scattered run. Exclusivity is what
                 makes the timing repeatable, not merely faster. --mem=0 is still
                 needed alongside it: --exclusive gives all the CPUs but memory
                 follows DefMemPerCPU (1024 MB x 144 = 144 GB of a 225 GB node).
               - --export=NONE REMOVED. sbatch --export=NONE also sets
                 SLURM_EXPORT_ENV=NONE in the job, which every `srun` in that job
                 then inherits -- so the model would start with none of the
                 environment the module load just set up (PATH, LD_LIBRARY_PATH,
                 the XIOS/netCDF libs). Harmless under Hydra, fatal under srun. #}
            --nodes={{ LFRIC_ATM_NODES }}
            --ntasks={{TOTAL_RANKS_REQ}}
            --ntasks-per-node={{ LFRIC_ATM_PPN }}
            --cpus-per-task=1
            --exclusive =
            --mem=0
{% else %}
        [[[directives]]]
            -l select={{LFRIC_ATM_NODES}}
            -q={{RUN_QUEUE}}
{% endif %}
{% endif %}
{% endif %}
